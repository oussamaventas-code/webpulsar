{%- comment -%}
  Contenido reemplazable del carrito. Vive aparte de main-cart.liquid para que
  cart.js pueda pedir sólo esto tras cada cambio de cantidad (?sections=main-cart)
  y sustituir el HTML sin recargar la página.

  Mantenimiento: se ofrece como un popup Sí/No (no un bloque siempre visible).
  Si el visitante dice que sí, elige uno de los 3 productos de mantenimiento;
  el precio y el `selling_plan` se leen en vivo del producto (Shopify
  Subscriptions), así que en cuanto el plan mensual exista en el producto,
  el botón empieza a añadirlo como suscripción sin tocar este archivo. Las
  listas de beneficios (tier*_features) son solo texto editable desde el tema.
{%- endcomment -%}

<p class="field__error cart-page__error" data-cart-error hidden role="alert"></p>

{%- if cart == empty -%}
  <div class="cart-page__empty" data-reveal="fade">
    <p class="t-lead">{{ 'sections.cart.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url | default: routes.root_url }}" class="btn btn--primary btn--lg">
      {{ 'general.continue_shopping' | t }}
      {% render 'icon', name: 'arrow-right', size: 16 %}
    </a>
  </div>
{%- else -%}
  <ul class="cart-lines" role="list">
    {%- for item in cart.items -%}
      <li class="cart-line" data-cart-line>
        <div class="cart-line__media">
          {%- if item.image != blank -%}
            {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '64px', alt: item.title }}
          {%- else -%}
            <span class="cart-line__media-fallback" aria-hidden="true">{% render 'icon', name: 'video', size: 20 %}</span>
          {%- endif -%}
        </div>

        <div class="cart-line__info">
          <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
          {%- if item.variant.title != 'Default Title' -%}
            <p class="cart-line__variant">{{ item.variant.title }}</p>
          {%- endif -%}
          {%- if item.selling_plan_allocation != blank -%}
            <p class="cart-line__plan">
              {% render 'icon', name: 'refresh', size: 12 %}
              {{ item.selling_plan_allocation.selling_plan.name }}
            </p>
          {%- endif -%}

          <button type="button" class="cart-line__remove" data-line-remove="{{ forloop.index }}">
            {{ 'sections.cart.remove_title' | t }}
          </button>
        </div>

        <div class="cart-line__qty">
          <div class="qty-stepper">
            <button type="button" class="qty-stepper__btn" data-qty-decrease data-line="{{ forloop.index }}" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.title }}">
              {% render 'icon', name: 'minus', size: 12 %}
            </button>
            <input
              type="number"
              class="qty-stepper__input"
              min="0"
              value="{{ item.quantity }}"
              data-qty-input
              data-line="{{ forloop.index }}"
              aria-label="{{ 'products.product.quantity.label' | t }}"
            >
            <button type="button" class="qty-stepper__btn" data-qty-increase data-line="{{ forloop.index }}" aria-label="{{ 'products.product.quantity.increase' | t: product: item.title }}">
              {% render 'icon', name: 'plus', size: 12 %}
            </button>
          </div>
        </div>

        <div class="cart-line__price">
          {%- if item.original_line_price != item.final_line_price -%}
            <span class="cart-line__price-compare">{{ item.original_line_price | money }}</span>
          {%- endif -%}
          <span>{{ item.final_line_price | money }}</span>
        </div>
      </li>
    {%- endfor -%}
  </ul>

  {%- liquid
    assign t1_handle = tier1_handle | default: 'mantenimiento-basico'
    assign t2_handle = tier2_handle | default: 'mantenimiento-pro'
    assign t3_handle = tier3_handle | default: 'mantenimiento-business'
    assign tier_handles_str = t1_handle | append: '|' | append: t2_handle | append: '|' | append: t3_handle
    assign tier_handles = tier_handles_str | split: '|'

    assign tier_features_str = tier1_features | append: '///' | append: tier2_features | append: '///' | append: tier3_features
    assign tier_features_list = tier_features_str | split: '///'

    assign has_care = false
    for item in cart.items
      if item.product.handle == t1_handle or item.product.handle == t2_handle or item.product.handle == t3_handle
        assign has_care = true
      endif
    endfor
  -%}
  {%- if has_care == false -%}
    <div class="cart-care-modal" data-cart-care-modal aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ care_heading | default: 'Mantenimiento mensual' }}">
      <div class="cart-care-modal__overlay" data-cart-care-dismiss></div>
      <div class="cart-care-modal__panel">
        <button type="button" class="cart-care-modal__close" data-cart-care-dismiss aria-label="{{ 'accessibility.close' | t }}">
          {% render 'icon', name: 'close', size: 15 %}
        </button>

        <div data-cart-care-step="ask">
          {%- if care_heading != blank -%}<p class="cart-care__heading">{{ care_heading }}</p>{%- endif -%}
          {%- if care_note != blank -%}<p class="cart-care__note">{{ care_note }}</p>{%- endif -%}
          <div class="cart-care-modal__actions">
            <button type="button" class="btn btn--primary btn--full" data-cart-care-yes>Sí, quiero mantenimiento</button>
            <button type="button" class="btn btn--text" data-cart-care-dismiss>No, gracias</button>
          </div>
        </div>

        <div data-cart-care-step="plans" hidden>
          <p class="cart-care__heading">Elige tu plan de mantenimiento</p>
          <div class="cart-care__options">
            {%- for handle in tier_handles -%}
              {%- liquid
                assign care_product = all_products[handle]
                assign care_features_raw = tier_features_list[forloop.index0]
                assign care_features = care_features_raw | newline_to_br | split: '<br />'
              -%}
              {%- if care_product != blank -%}
                {%- liquid
                  assign care_variant = care_product.selected_or_first_available_variant
                  assign care_allocations = care_variant.selling_plan_allocations
                  assign care_plan = care_allocations.first.selling_plan
                -%}
                <button
                  type="button"
                  class="cart-care__option{% if care_plan == blank %} cart-care__option--disabled{% endif %}"
                  data-cart-add-extra="{{ care_variant.id }}"
                  {%- if care_plan != blank %}
                    data-selling-plan="{{ care_plan.id }}"
                  {%- endif %}
                  {%- if care_plan == blank %}
                    disabled
                  {%- endif %}
                >
                  <span class="cart-care__option-head">
                    <span class="cart-care__option-name">{{ care_product.title | remove: 'Mantenimiento ' }}</span>
                    <span class="cart-care__option-price">
                      {%- if care_plan != blank -%}
                        {{ care_allocations.first.price | money }}<small>/mes</small>
                      {%- else -%}
                        {{ care_variant.price | money }}<small>Próximamente</small>
                      {%- endif -%}
                    </span>
                  </span>
                  {%- if care_features.size > 0 -%}
                    <ul class="cart-care__option-features">
                      {%- for feature in care_features -%}
                        {%- assign line = feature | strip_newlines | strip -%}
                        {%- if line != blank -%}
                          <li>
                            {% render 'icon', name: 'check', size: 10 %}
                            {{ line }}
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <p class="cart-care__error" data-cart-care-error hidden></p>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="cart-page__foot">
    <div class="cart-page__totals">
      <div class="cart-page__totals-row">
        <span>{{ 'sections.cart.subtotal' | t }}</span>
        <span class="t-h4">{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-page__note t-sm t-dim">
        {% render 'icon', name: 'shield', size: 13 %}
        {{ 'sections.cart.digital_note' | t }}
      </p>
    </div>

    <form action="{{ routes.cart_url }}" method="post" class="cart-page__checkout-form">
      <button type="submit" name="checkout" class="btn btn--primary btn--lg btn--full">
        {{ 'sections.cart.checkout' | t }}
        {% render 'icon', name: 'arrow-right', size: 16 %}
      </button>
      <a href="{{ routes.all_products_collection_url | default: routes.root_url }}" class="btn btn--text cart-page__continue">
        {{ 'general.continue_shopping' | t }}
      </a>
    </form>
  </div>
{%- endif -%}
