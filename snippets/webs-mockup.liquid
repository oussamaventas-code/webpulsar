{%- comment -%}
  webs-mockup — maqueta de una web de negocio local.
  Si se pasa `image`, se sustituye toda la maqueta CSS por la imagen (mockup ya generado).
{%- endcomment -%}

{%- assign has_valid_image = false -%}
{%- if image != blank and image contains 'shopify://' == false -%}
  {%- assign has_valid_image = true -%}
{%- endif -%}

{%- if has_valid_image -%}
  <div class="qw-mock qw-mock--photo-only" aria-hidden="true" style="border-radius: 14px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,.35);">
    {{
      image
      | image_url: width: 1600
      | image_tag:
        class: 'qw-mock__full-photo',
        loading: 'lazy',
        widths: '600, 900, 1200, 1600',
        sizes: '(max-width: 749px) 92vw, 620px',
        alt: '',
        style: 'display:block; width:100%; height:auto;'
    }}
  </div>
{%- else -%}

