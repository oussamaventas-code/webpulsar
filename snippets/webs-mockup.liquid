-%}

<div class="qw-mock{% if is_phone %} qw-mock--phone{% endif %}" style="--mk-brand: {{ mk_brand }};" aria-hidden="true">
  {%- unless is_phone or hide_chrome -%}
    <div class="qw-mock__chrome">
      <div class="qw-mock__dots"><i></i><i></i><i></i></div>
      <div class="qw-mock__url">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg>
        {{ mk_url }}
      </div>
    </div>
  {%- endunless -%}

  <div class="qw-mock__bar">
    <p class="qw-mock__logo">{{ mk_name }} <b>{{ mk_name_b }}</b></p>
    <nav class="qw-mock__nav">
      {%- for item in nav_items -%}<i>{{ item }}</i>{%- endfor -%}
    </nav>
    <span class="qw-mock__cta">{{ mk_cta }}</span>
  </div>

  <div class="qw-mock__hero{% if mk_photo %} has-photo{% endif %}">
    {%- if mk_photo -%}
      <img class="qw-mock__photo" src="{{ mk_photo }}" alt="{{ mk_photo_alt }}" loading="lazy" />
    {%- endif -%}
    <div class="qw-mock__hero-copy">
      <p class="qw-mock__eyebrow">{{ mk_eyebrow }}</p>
      <p class="qw-mock__title">{{ mk_title }}</p>
      <p class="qw-mock__sub">{{ mk_sub }}</p>

      <div class="qw-mock__btns">
        <span class="qw-mock__btn">{{ mk_cta }}</span>
        <span class="qw-mock__btn qw-mock__btn--wa">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.86.5 3.6 1.36 5.1L2 22l5.2-1.52a9.8 9.8 0 0 0 4.84 1.26h.01c5.43 0 9.84-4.4 9.84-9.84 0-5.44-4.41-9.9-9.85-9.9Zm5.76 14.02c-.24.68-1.4 1.3-1.94 1.34-.5.05-1.13.07-1.82-.11a16.6 16.6 0 0 1-1.65-.61c-2.9-1.26-4.8-4.2-4.94-4.4-.15-.2-1.19-1.58-1.19-3.02 0-1.43.75-2.14 1.02-2.43.27-.3.58-.37.78-.37h.56c.18 0 .42-.07.66.5.24.6.83 2.03.9 2.18.08.15.13.32.03.52-.1.2-.15.32-.3.5l-.44.51c-.15.15-.3.31-.13.61.17.3.76 1.25 1.63 2.03 1.12 1 2.06 1.3 2.36 1.45.3.15.47.13.64-.08.17-.2.74-.86.94-1.16.2-.3.4-.25.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.72-.17 1.4Z"/></svg>
          WhatsApp
        </span>
      </div>

      <div class="qw-mock__rating">
        <span class="qw-mock__stars">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 2.6 2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.44 6.19 20.5l1.11-6.47L2.6 9.45l6.5-.95L12 2.6Z"/></svg>
          {%- endfor -%}
        </span>
        {{ mk_rating }} · {{ mk_reviews }} reseñas en Google
      </div>
    </div>

    <div class="qw-mock__aside">
      <p class="qw-mock__aside-title">Contacto</p>
      <span class="qw-mock__aside-open"><i></i> Abierto ahora</span>
      <div class="qw-mock__aside-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="M12 7v5.3l3.4 2"/></svg>
        <b>{{ mk_hours }}</b>
      </div>
      <div class="qw-mock__aside-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.4 3.5h3l1.5 3.8-2 1.3a10.4 10.4 0 0 0 4.5 4.5l1.3-2 3.8 1.5v3a1.9 1.9 0 0 1-2.1 1.9A15.6 15.6 0 0 1 4.5 5.6a1.9 1.9 0 0 1 1.9-2.1Z"/></svg>
        <b>{{ mk_phone }}</b>
      </div>
      <span class="qw-mock__aside-cta">{{ mk_cta }}</span>
    </div>
  </div>

  <div class="qw-mock__body">
    <p class="qw-mock__h">{{ mk_rows_title }}</p>
    <div class="qw-mock__rows">
      {%- for row in row_items -%}
        {%- assign cells = row | split: '|' -%}
        <div class="qw-mock__row">
          <b>{{ cells[0] }}</b>
          <span>{{ cells[1] }}</span>
          <em>{{ cells[2] }}</em>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="qw-mock__foot">
    <span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
      {{ mk_addr }}
    </span>
    <span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="M12 7v5.3l3.4 2"/></svg>
      {{ mk_hours }}
    </span>
  </div>

  <span class="qw-mock__wa">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.86.5 3.6 1.36 5.1L2 22l5.2-1.52a9.8 9.8 0 0 0 4.84 1.26h.01c5.43 0 9.84-4.4 9.84-9.84 0-5.44-4.41-9.9-9.85-9.9Zm5.76 14.02c-.24.68-1.4 1.3-1.94 1.34-.5.05-1.13.07-1.82-.11a16.6 16.6 0 0 1-1.65-.61c-2.9-1.26-4.8-4.2-4.94-4.4-.15-.2-1.19-1.58-1.19-3.02 0-1.43.75-2.14 1.02-2.43.27-.3.58-.37.78-.37h.56c.18 0 .42-.07.66.5.24.6.83 2.03.9 2.18.08.15.13.32.03.52-.1.2-.15.32-.3.5l-.44.51c-.15.15-.3.31-.13.61.17.3.76 1.25 1.63 2.03 1.12 1 2.06 1.3 2.36 1.45.3.15.47.13.64-.08.17-.2.74-.86.94-1.16.2-.3.4-.25.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.72-.17 1.4Z"/></svg>
  </span>
</div>
{%- endif -%}
