{%- comment -%}
  Datos estructurados (JSON-LD) de WebPulsar.
  Grafo unificado Schema.org con ProfessionalService, WebSite, Service, Ofertas y FAQPage
  para maximizar Rich Snippets en Google y visibilidad en motores de IA (RAG / GEO).
{%- endcomment -%}

{%- liquid
  assign starter = all_products['web-starter-pagina-profesional']
  assign pro = all_products['web-pro-presencia-online-completa']
  assign business = all_products['web-business-herramienta-de-ventas']
  assign currency = cart.currency.iso_code | default: shop.currency | default: 'EUR'

  assign starter_desc = 'Una página profesional con diseño responsive, información del negocio, servicios, fotos, botón de WhatsApp, ubicación y formulario de contacto.'
  assign pro_desc = 'Hasta 5 páginas con diseño personalizado, SEO básico, formularios, Google Maps, redes sociales y galería profesional.'
  assign business_desc = 'Web completa con reservas y citas, automatizaciones, SEO avanzado, formularios avanzados, integraciones, Google Business y analítica.'
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["ProfessionalService", "Organization"],
      "@id": "{{ shop.url }}/#organization",
      "name": "WebPulsar",
      "alternateName": "Webpulsar.es",
      "url": "{{ shop.url }}",
      "description": "Agencia de diseño de páginas web profesionales, desarrollo de software a medida, automatizaciones con IA/WhatsApp y posicionamiento SEO local para pymes y autónomos en Molina de Segura, Murcia y toda España.",
      "email": "contacto@webpulsar.es",
      "telephone": ["+34632334756", "+34641279131"],
      "priceRange": "49€ - 499€",
      "currenciesAccepted": "EUR",
      "paymentAccepted": "Cash, Credit Card, Bank Transfer, Bizum",
      "sameAs": [
        "https://es.wikipedia.org/wiki/Molina_de_Segura",
        "https://www.wikidata.org/wiki/Q949884",
        "https://es.wikipedia.org/wiki/Regi%C3%B3n_de_Murcia",
        "https://www.wikidata.org/wiki/Q5772"
      ],
      "hasMap": "https://maps.google.com/?q=Molina+de+Segura,+Murcia",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "38.0528",
        "longitude": "-1.2131"
      },
      "areaServed": [
        {
          "@type": "City",
          "name": "Molina de Segura",
          "postalCode": "30500",
          "sameAs": "https://es.wikipedia.org/wiki/Molina_de_Segura"
        },
        {
          "@type": "City",
          "name": "Murcia",
          "postalCode": "30001",
          "sameAs": "https://es.wikipedia.org/wiki/Murcia"
        },
        {
          "@type": "City",
          "name": "Alcantarilla",
          "postalCode": "30820"
        },
        {
          "@type": "City",
          "name": "Las Torres de Cotillas",
          "postalCode": "30565"
        },
        {
          "@type": "City",
          "name": "Cieza",
          "postalCode": "30530"
        },
        {
          "@type": "City",
          "name": "Cartagena",
          "postalCode": "30201"
        },
        {
          "@type": "AdministrativeArea",
          "name": "Región de Murcia",
          "sameAs": "https://es.wikipedia.org/wiki/Regi%C3%B3n_de_Murcia"
        },
        {
          "@type": "Country",
          "name": "España"
        }
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Molina de Segura",
        "postalCode": "30500",
        "addressRegion": "Murcia",
        "addressCountry": "ES"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
          ],
          "opens": "09:00",
          "closes": "20:00"
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios Digitales WebPulsar",
        "itemListElement": [
          {
            "@type": "OfferCatalog",
            "name": "Diseño y Creación Web",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Diseño Web Profesional y Responsive en Murcia y Molina de Segura"
                }
              }
            ]
          },
          {
            "@type": "OfferCatalog",
            "name": "Automatizaciones de Procesos",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Automatización de WhatsApp, Reservas Online y CRM para Pymes"
                }
              }
            ]
          },
          {
            "@type": "OfferCatalog",
            "name": "Posicionamiento SEO Local",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Posicionamiento SEO Local en Google y Google Business Profile en Murcia"
                }
              }
            ]
          }
        ]
      },
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": "+34632334756",
          "contactType": "customer service",
          "availableLanguage": ["Spanish"]
        },
        {
          "@type": "ContactPoint",
          "telephone": "+34641279131",
          "contactType": "sales",
          "availableLanguage": ["Spanish"]
        }
      ]
      {%- if settings.logo != blank -%},
      "logo": "https:{{ settings.logo | image_url: width: 512 }}"
      {%- endif -%}
    },
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "url": "{{ shop.url }}",
      "name": "WebPulsar",
      "publisher": { "@id": "{{ shop.url }}/#organization" },
      "inLanguage": "es-ES"
    },
    {
      "@type": "Service",
      "@id": "{{ shop.url }}/#service",
      "name": "Diseño de páginas web para negocios locales",
      "serviceType": "Diseño web y Automatizaciones",
      "provider": { "@id": "{{ shop.url }}/#organization" },
      "areaServed": { "@type": "Country", "name": "España" },
      "audience": {
        "@type": "BusinessAudience",
        "name": "Negocios locales y pymes que necesitan presencia online: peluquerías, estética, talleres, restaurantes, fisioterapia, clínicas e inmobiliarias"
      },
      "description": "Creamos la web de tu negocio en pago único y sin permanencia, desde 49 €. Nos cuentas cómo es tu negocio, diseñamos y montamos la página, y te la entregamos lista para que tus clientes te encuentren y te escriban directamente por WhatsApp. Mantenimiento mensual opcional.",
      "termsOfService": "{{ shop.url }}/pages/terminos",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "{{ currency }}",
        "lowPrice": "{% if starter != blank %}{{ starter.price | divided_by: 100.0 }}{% else %}49.00{% endif %}",
        "highPrice": "{% if business != blank %}{{ business.price | divided_by: 100.0 }}{% else %}499.00{% endif %}",
        "offerCount": 3,
        "offers": [
          {
            "@type": "Offer",
            "name": {% if starter != blank %}{{ starter.title | json }}{% else %}"Plan STARTER — Web 1 Página"{% endif %},
            "description": {{ starter_desc | json }},
            "price": "{% if starter != blank %}{{ starter.price | divided_by: 100.0 }}{% else %}49.00{% endif %}",
            "priceCurrency": "{{ currency }}",
            "url": "{% if starter != blank %}{{ shop.url }}{{ starter.url }}{% else %}{{ shop.url }}#planes{% endif %}",
            "availability": "https://schema.org/InStock"
          },
          {
            "@type": "Offer",
            "name": {% if pro != blank %}{{ pro.title | json }}{% else %}"Plan PRO — Hasta 5 Páginas"{% endif %},
            "description": {{ pro_desc | json }},
            "price": "{% if pro != blank %}{{ pro.price | divided_by: 100.0 }}{% else %}199.00{% endif %}",
            "priceCurrency": "{{ currency }}",
            "url": "{% if pro != blank %}{{ shop.url }}{{ pro.url }}{% else %}{{ shop.url }}#planes{% endif %}",
            "availability": "https://schema.org/InStock"
          },
          {
            "@type": "Offer",
            "name": {% if business != blank %}{{ business.title | json }}{% else %}"Plan BUSINESS — Web Completa y Automatizaciones"{% endif %},
            "description": {{ business_desc | json }},
            "price": "{% if business != blank %}{{ business.price | divided_by: 100.0 }}{% else %}499.00{% endif %}",
            "priceCurrency": "{{ currency }}",
            "url": "{% if business != blank %}{{ shop.url }}{{ business.url }}{% else %}{{ shop.url }}#planes{% endif %}",
            "availability": "https://schema.org/InStock"
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "{{ shop.url }}/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué incluye la web de 49 €?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una página profesional con la información de tu negocio, tus servicios, fotos, ubicación, formulario de contacto y botón directo de WhatsApp. 100% adaptada a móvil y lista para publicar."
          }
        },
        {
          "@type": "Question",
          "name": "¿El dominio y el hosting están incluidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El dominio y hosting no están incluidos en el pago único de 49 € para que el dominio quede 100% a tu nombre. Te asesoramos con la opción más económica y recomendada antes de empezar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto tardáis en entregar la web?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La web del plan Starter suele entregarse en menos de 7 días una vez recibida la información básica de tu negocio y fotos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo pedir cambios sobre el diseño?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, cada plan incluye 1 ronda de revisiones sobre la primera versión para dejarla exactamente a tu gusto."
          }
        },
        {
          "@type": "Question",
          "name": "¿La web funciona perfectamente en móviles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, todas nuestras webs se desarrollan bajo enfoque mobile-first garantizando carga ultra-rápida y navegación fluida en smartphones."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo contratar mantenimiento mensual?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, el mantenimiento es 100% opcional desde 19,90 €/mes para cubrir actualizaciones, cambios de texto o fotos y soporte técnico continuo sin permanencia."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hacéis diseño web y automatizaciones para negocios en Molina de Segura y Murcia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, en WebPulsar estamos especializados en creación de páginas web, automatizaciones de procesos y SEO local para pymes y autónomos en Molina de Segura, Murcia Capital, Alcantarilla, Las Torres de Cotillas, Cieza, Archena y toda la Región de Murcia, además de atender proyectos en toda España de manera online."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo ayuda el posicionamiento SEO local a mi negocio físico o pyme?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Optimizamos la arquitectura de tu web, metaetiquetas, contenidos y ficha de Google Business Profile para que aparezcas en el Top de Google y Google Maps cuando clientes en tu zona buscan tus servicios, captando contactos directos por WhatsApp de inmediato."
          }
        }
      ]
    }
  ]
}
</script>
