{% layout none %}
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Diseño Web en Murcia y Molina de Segura | Automatización y SEO | WebPulsar</title>
  <meta name="description" content="Agencia de diseño web y automatizaciones en Murcia y Molina de Segura. Páginas web desde 49 € pago único, SEO local en Google y reservas online. WhatsApp rápido.">
  <link rel="canonical" href="{{ canonical_url | default: shop.url }}">
  <meta name="theme-color" content="#E8E4DD">
  <meta name="robots" content="index, follow">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {%- else -%}
    <link rel="icon" type="image/png" href="{{ 'apple-touch-icon.png' | asset_url }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">
  {%- endif -%}

  <meta property="og:site_name" content="WebPulsar">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url | default: shop.url }}">
  <meta property="og:title" content="Diseño Web en Murcia y Molina de Segura | Automatización y SEO | WebPulsar">
  <meta property="og:description" content="Creamos páginas web profesionales desde 49 € pago único en Murcia y Molina de Segura. Automatizaciones de procesos, reservas y SEO local en Google.">
  <meta property="og:locale" content="es_ES">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Diseño Web en Murcia y Molina de Segura | Automatización y SEO | WebPulsar">
  <meta name="twitter:description" content="Diseño web profesional y automatizaciones para negocios en Molina de Segura y Murcia desde 49 €. Posicionamiento SEO en Google y WhatsApp integrado.">

  {% render 'structured-data' %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  {{ 'solar-landing.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vendor-react.js' | asset_url }}" defer></script>
  <script src="{{ 'vendor-react-dom.js' | asset_url }}" defer></script>
  <script src="{{ 'vendor-gsap.js' | asset_url }}" defer></script>
  <script src="{{ 'vendor-scrolltrigger.js' | asset_url }}" defer></script>
  <script src="{{ 'solar-landing.js' | asset_url }}" defer></script>
</head>
<body>
  <div id="root"></div>
</body>
</html>
