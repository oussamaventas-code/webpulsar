{{ 'qm-webs.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<section class="section section--tight qw-care" id="mantenimiento">
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if s.eyebrow != blank -%}
        <p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>
      {%- endif -%}
      <h2 class="t-h2" data-reveal>{{ s.heading }}</h2>
      {%- if s.body != blank -%}
        <p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>
      {%- endif -%}
    </div>

    <div class="qw-care__grid" data-stagger="80">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign features = b.features | newline_to_br | split: '<br />'
        -%}
        <article class="qw-care__item" data-reveal {{ block.shopify_attributes }}>
          <p class="qw-care__name">{{ b.name }}</p>

          <div class="qw-care__price">
            <span class="qw-price qw-price--md">
              <span>{{ b.price }}</span>
              <span class="qw-price__cur">{{ b.currency | default: '€' }}</span>
              <span class="qw-price__per">{{ b.period | default: '/mes' }}</span>
            </span>
          </div>

          {%- if b.tagline != blank -%}
            <p class="qw-care__text">{{ b.tagline }}</p>
          {%- endif -%}

          {%- if b.change_limit != blank -%}
            <p class="chip chip--green qw-care__limit">
              {% render 'icon', name: 'check', size: 11 %}
              {{ b.change_limit }}
            </p>
          {%- endif -%}

          <ul class="qw-ticks qw-care__list">
            {%- for feature in features -%}
              {%- assign line = feature | strip_newlines | strip -%}
              {%- if line != blank -%}
                <li class="qw-tick">
                  <span class="qw-tick__mark">{% render 'icon', name: 'check', size: 10 %}</span>
                  {{ line }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </article>
      {%- endfor -%}
    </div>

    <div class="qw-care__foot" data-reveal="fade">
      {%- if s.note != blank -%}
        <p class="qw-note" style="max-width: 760px; margin-inline: auto;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.6v.2"/></svg>
          <span>{{ s.note }}</span>
        </p>
      {%- endif -%}

      {%- if s.cta_label != blank -%}
        <div class="btn-row" style="justify-content: center; margin-top: var(--s-6);">
          <a href="{{ s.cta_url | default: '#quiero-mi-web' }}" class="btn btn--ghost" data-qw-cta="click_care" data-plan="mantenimiento">
            {{ s.cta_label }}
            {% render 'icon', name: 'arrow-right', size: 15 %}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Webs · Mantenimiento",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Mantenimiento" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "¿Quieres olvidarte de la parte técnica?" },
    { "type": "textarea", "id": "body", "label": "Subtítulo", "default": "Opcional en todos los planes. Si lo prefieres, te entregamos la web y la gestionas tú." },
    { "type": "textarea", "id": "note", "label": "Nota", "default": "El mantenimiento cubre actualizaciones, cambios de contenido y soporte. Cada nivel indica cuántos cambios puedes pedir al mes (los cambios no usados no se acumulan al mes siguiente). Se factura mes a mes y puedes darte de baja cuando quieras." },
    { "type": "text", "id": "cta_label", "label": "Botón", "default": "Preguntar por el mantenimiento" },
    { "type": "url", "id": "cta_url", "label": "Enlace del botón" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Nivel de mantenimiento",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "default": "Mantenimiento básico" },
        { "type": "text", "id": "price", "label": "Importe", "default": "49" },
        { "type": "text", "id": "currency", "label": "Moneda", "default": "€" },
        { "type": "text", "id": "period", "label": "Periodo", "default": "/mes" },
        { "type": "textarea", "id": "tagline", "label": "Para quién es", "default": "Para webs de una página que solo necesitan estar al día." },
        { "type": "text", "id": "change_limit", "label": "Límite de cambios al mes", "info": "Se muestra destacado. Ej: 'Hasta 2 cambios al mes'.", "default": "Hasta 2 cambios al mes" },
        { "type": "textarea", "id": "features", "label": "Incluye", "info": "Una línea por característica.", "default": "Actualizaciones de la web\nSoporte por WhatsApp o email" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Webs · Mantenimiento",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "name": "Mantenimiento básico", "price": "49",
            "tagline": "Para webs de una página que solo necesitan estar al día.",
            "change_limit": "Hasta 2 cambios al mes",
            "features": "Actualizaciones de la web\nSoporte por WhatsApp o email"
          }
        },
        {
          "type": "tier",
          "settings": {
            "name": "Mantenimiento PRO", "price": "79",
            "tagline": "Para webs de varias páginas con contenido que cambia a menudo.",
            "change_limit": "Hasta 5 cambios al mes",
            "features": "Todo lo del básico\nRespuesta prioritaria\nRevisión periódica de la web"
          }
        },
        {
          "type": "tier",
          "settings": {
            "name": "Mantenimiento BUSINESS", "price": "129",
            "tagline": "Para webs con reservas, formularios o integraciones activas.",
            "change_limit": "Cambios ilimitados",
            "features": "Todo lo del PRO\nSoporte de las funciones avanzadas\nInforme de rendimiento"
          }
        }
      ]
    }
  ]
}
{% endschema %}
