{{ 'qm-webs.css' | asset_url | stylesheet_tag }}
{{ 'qm-webs-extra.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<section class="section qw-work" id="proyectos">
  <span class="halo halo--tr" data-parallax="0.07" style="--halo-color: var(--c-violet); --halo-opacity: 0.22;" aria-hidden="true"></span>
  <span class="halo halo--bl" data-parallax="0.05" style="--halo-color: var(--c-cyan); --halo-opacity: 0.16;" aria-hidden="true"></span>

  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if s.eyebrow != blank -%}
        <p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>
      {%- endif -%}
      <h2 class="t-h2" data-reveal>
        {{ s.heading }}
        {%- if s.heading_accent != blank -%}
          <span class="t-grad">{{ s.heading_accent }}</span>
        {%- endif -%}
      </h2>
      {%- if s.body != blank -%}
        <p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.body }}</p>
      {%- endif -%}
    </div>

    <div class="qw-work__container">
      <div class="qw-work__grid" data-stagger="90" data-stagger-max="10">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- assign tags = b.tags | split: ',' -%}
          <article class="qw-work-card card--glow" data-reveal {{ block.shopify_attributes }}>
            <!-- Mockup Window Bar -->
            <div class="qw-work-card__preview">
              <div class="qw-work-card__chrome">
                <span class="qw-work-card__dots" aria-hidden="true">
                  <i class="qw-work-card__dot"></i>
                  <i class="qw-work-card__dot"></i>
                  <i class="qw-work-card__dot"></i>
                </span>
                <span class="qw-work-card__address">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  <span>{{ b.domain | default: 'web-en-vivo.com' }}</span>
                </span>
                <span class="qw-work-card__badge-live">
                  <span class="chip__dot chip__dot--pulse" aria-hidden="true"></span>
                  LIVE
                </span>
              </div>

              <!-- Media Showcase -->
              <div class="qw-work-card__media">
                {%- if b.video_url != blank -%}
                  <video
                    class="qw-work-card__video"
                    data-lazy-video
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="auto"
                    {% if b.image != blank %}poster="{{ b.image | image_url: width: 800 }}"{% endif %}
                  >
                    <source src="{{ b.video_url }}" data-src="{{ b.video_url }}" type="video/mp4">
                  </video>
                {%- elsif b.image != blank -%}
                  <img class="qw-work-card__img" src="{{ b.image | image_url }}" alt="{{ b.title | escape }}" loading="lazy">
                {%- endif -%}

                <div class="qw-work-card__canvas qw-work-card__canvas--{{ b.style_theme | default: 'tech' }}" aria-hidden="true">
                  <div class="qw-work-card__canvas-mesh"></div>
                  <div class="qw-work-card__canvas-content">
                    <span class="qw-work-card__canvas-tag">{{ b.badge }}</span>
                    <span class="qw-work-card__canvas-name">{{ b.title }}</span>
                    <span class="qw-work-card__canvas-tech">{{ b.highlight }}</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Content -->
            <div class="qw-work-card__body">
              <div class="qw-work-card__meta">
                <span class="chip chip--sm chip--violet">{{ b.badge }}</span>
                {%- if b.highlight != blank -%}
                  <span class="qw-work-card__highlight">{{ b.highlight }}</span>
                {%- endif -%}
              </div>

              <h3 class="qw-work-card__title">{{ b.title }}</h3>
              <p class="qw-work-card__desc">{{ b.desc }}</p>

              {%- if tags.size > 0 -%}
                <div class="qw-work-card__tags">
                  {%- for tag in tags -%}
                    {%- assign tag_clean = tag | strip -%}
                    {%- if tag_clean != blank -%}
                      <span class="qw-work-card__tag">{{ tag_clean }}</span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <div class="qw-work-card__foot">
                <a
                  href="{{ b.url }}"
                  target="_blank"
                  rel="noopener"
                  class="btn btn--ghost btn--sm qw-work-card__btn"
                  data-qw-cta="view_project"
                  data-project="{{ b.title | handle }}"
                >
                  <span>Ver proyecto en vivo</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>

      <div class="qw-work__nav-hint" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        <span>Desliza para ver más proyectos</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Webs · Nuestro Trabajo",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "PROYECTOS REALES" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "No vendemos maquetas." },
    { "type": "text", "id": "heading_accent", "label": "Titular con acento", "default": "Esto es lo que creamos." },
    { "type": "textarea", "id": "body", "label": "Subtítulo", "default": "Mira algunos de los proyectos y plataformas reales que hemos diseñado y desarrollado. Desde webs interactivas de alto rendimiento hasta sistemas SaaS a medida." }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Proyecto",
      "limit": 10,
      "settings": [
        { "type": "text", "id": "title", "label": "Título del proyecto", "default": "Proyecto Destacado" },
        { "type": "url", "id": "url", "label": "URL del proyecto en vivo" },
        { "type": "text", "id": "domain", "label": "Dominio visible", "default": "ejemplo.vercel.app" },
        { "type": "text", "id": "badge", "label": "Tipo / Plan", "default": "Plan Pro" },
        { "type": "text", "id": "highlight", "label": "Métrica o detalle destacado", "default": "60 FPS · Responsive" },
        { "type": "textarea", "id": "desc", "label": "Descripción corta" },
        { "type": "text", "id": "tags", "label": "Etiquetas de tecnología (separadas por coma)", "default": "React, Next.js, Framer Motion" },
        {
          "type": "select",
          "id": "style_theme",
          "label": "Estilo visual del cover",
          "options": [
            { "value": "tech", "label": "Tech Cyan" },
            { "value": "neon", "label": "Neon Violet" },
            { "value": "warm", "label": "Warm Coral" },
            { "value": "dark", "label": "Emerald Dark" },
            { "value": "brand", "label": "Editorial Brand" }
          ],
          "default": "tech"
        },
        { "type": "text", "id": "video_url", "label": "URL del vídeo preview (MP4 opcional)" },
        { "type": "image_picker", "id": "image", "label": "Imagen / Captura del proyecto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Webs · Nuestro Trabajo",
      "blocks": [
        {
          "type": "project",
          "settings": {
            "title": "Portfolio Personal Interactivo",
            "url": "https://mi-portfolio-one-lake.vercel.app/",
            "domain": "mi-portfolio-one-lake.vercel.app",
            "badge": "Nivel Intermedio · Experiencia Digital",
            "highlight": "60 FPS · Next.js & 3D",
            "desc": "Experiencia inmersiva con animaciones basadas en física, transiciones fluidas y diseño editorial de alta gama para perfiles creativos.",
            "tags": "React, Next.js, Framer Motion, 3D Web, UI/UX",
            "style_theme": "neon"
          }
        },
        {
          "type": "project",
          "settings": {
            "title": "ZenCut — SaaS para Barberías",
            "url": "https://barber-saas-pi.vercel.app",
            "domain": "barber-saas-pi.vercel.app",
            "badge": "A Medida · Plataforma SaaS",
            "highlight": "Gestión en tiempo real",
            "desc": "Software integral en la nube: gestión de reservas por barbero y horario, catálogo interactivo de servicios, control de clientes y panel de métricas.",
            "tags": "Java, SaaS, CRUD, SQL, Panel de Control, API",
            "style_theme": "tech"
          }
        },
        {
          "type": "project",
          "settings": {
            "title": "Boles de Frutas — E-commerce",
            "url": "https://bowl-food-web.vercel.app/",
            "domain": "bowl-food-web.vercel.app",
            "badge": "Plan Pro · E-commerce Experiencial",
            "highlight": "Selector dual frío / caliente",
            "desc": "Tienda gastronómica con selector interactivo por temperatura, microinteracciones dinámicas, diseño apetitoso y checkout directo optimizado.",
            "tags": "React, Tailwind, Framer Motion, E-commerce, Mobile-First",
            "style_theme": "warm"
          }
        },
        {
          "type": "project",
          "settings": {
            "title": "Imaan by Belbaz — Plataforma Digital",
            "url": "https://ramadan-deen.vercel.app/",
            "domain": "ramadan-deen.vercel.app",
            "badge": "A Medida · Web App Fullstack",
            "highlight": "Arquitectura Fullstack",
            "desc": "Aplicación web completa con persistencia en base de datos, autenticación segura, widgets interactivos y despliegue de alto rendimiento.",
            "tags": "Full Stack, Node.js, MongoDB, React, PWA, Cloud",
            "style_theme": "dark"
          }
        },
        {
          "type": "project",
          "settings": {
            "title": "IMAAN BY BELBAZ — Colección Exclusiva",
            "url": "https://imaan-belbaz-x-drake.vercel.app/",
            "domain": "imaan-belbaz.vercel.app",
            "badge": "Alta Gama · Tienda de Marca",
            "highlight": "Lookbook inmersivo",
            "desc": "Tienda digital de moda streetwear premium con dirección de arte editorial, navegación fluida, lookbook interactivo y estética depurada.",
            "tags": "Next.js, E-commerce, Branding, Diseño Web, Awwwards Style",
            "style_theme": "brand"
          }
        }
      ]
    }
  ]
}
{% endschema %}
