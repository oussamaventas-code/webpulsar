{{ 'qm-webs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'qm-webs.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
-%}

<section class="section qw-offer" data-qw-offer>
  <span class="halo halo--bc" data-parallax="0.08" style="--halo-color: var(--c-violet); --halo-opacity: 0.2;" aria-hidden="true"></span>

  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if s.eyebrow != blank -%}
        <p class="t-label" data-reveal="fade">{{ s.eyebrow }}</p>
      {%- endif -%}
      <h2 class="t-h2" data-reveal>{{ s.heading }}</h2>
      {%- if s.subheading != blank -%}
        <p class="t-lead" data-reveal style="--reveal-delay: 80ms">{{ s.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="qw-offer__card card--glow" data-reveal="scale">
      <div>
        {%- if s.plan_name != blank -%}
          <p class="qw-offer__badge">
            <span class="chip chip--violet">{{ s.plan_name }}</span>
          </p>
        {%- endif -%}

        <div class="qw-offer__price">
          <span class="qw-price qw-price--xl">
            <span data-count-to="{{ s.price }}" data-count-decimals="0">0</span>
            <span class="qw-price__cur">{{ s.currency }}</span>
          </span>
          {%- if s.pay_label != blank -%}
            <span class="qw-offer__pay">{{ s.pay_label }}</span>
          {%- endif -%}
        </div>

        {%- if s.lead != blank -%}
          <p class="t-body qw-offer__lead">{{ s.lead }}</p>
        {%- endif -%}

        <div class="qw-offer__actions">
          <a
            href="{% if s.starter_variant_id != blank %}/cart/{{ s.starter_variant_id }}:1{% else %}{{ s.cta_url | default: '#quiero-mi-web' }}{% endif %}"
            class="btn btn--primary btn--lg"
            data-qw-cta="click_starter"
            data-plan="starter"
            {%- if s.starter_variant_id != blank %}
              data-qw-buy="{{ s.starter_variant_id }}"
            {%- endif %}
          >
            {{ s.cta_label }}
            {% render 'icon', name: 'arrow-right', size: 16 %}
          </a>

          {%- if s.cta2_label != blank -%}
            <a href="{{ s.cta2_url | default: '#planes' }}" class="btn btn--text" data-qw-cta="click_plans">
              {{ s.cta2_label }}
              <span class="btn__arrow">{% render 'icon', name: 'arrow-right', size: 15 %}</span>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div>
        <div class="qw-offer__mockup" data-parallax="0.04">
          {% render 'webs-mockup', kind: s.mockup_kind, image: s.mockup_image, phone: false %}
          {%- if s.chip1_text != blank -%}
            <span class="qw-devices__chip qw-devices__chip--a">{% render 'icon', name: 'check', size: 13 %} {{ s.chip1_text }}</span>
          {%- endif -%}
          {%- if s.chip2_text != blank -%}
            <span class="qw-devices__chip qw-devices__chip--b">{% render 'icon', name: 'check', size: 13 %} {{ s.chip2_text }}</span>
          {%- endif -%}
        </div>

        {%- if s.list_title != blank -%}
          <p class="qw-offer__list-title">{{ s.list_title }}</p>
        {%- endif -%}

        <ul class="qw-ticks qw-ticks--2">
          {%- for block in section.blocks -%}
            <li class="qw-tick" {{ block.shopify_attributes }}>
              <span class="qw-tick__mark">{% render 'icon', name: 'check', size: 10 %}</span>
              {{ block.settings.text }}
            </li>
          {%- endfor -%}
        </ul>

        {%- if s.note != blank -%}
          <p class="qw-note qw-offer__note">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.6v.2"/></svg>
            <span>{{ s.note }}</span>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Webs · Oferta 49 €",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Empieza aquí" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Empieza por 49 €." },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Una página profesional, con todo lo que un cliente necesita para encontrarte y escribirte. Sin cuotas ni permanencia." },
    { "type": "header", "content": "Precio" },
    { "type": "text", "id": "plan_name", "label": "Nombre del plan", "default": "STARTER" },
    { "type": "text", "id": "price", "label": "Importe", "default": "49" },
    { "type": "text", "id": "currency", "label": "Moneda", "default": "€" },
    { "type": "text", "id": "pay_label", "label": "Tipo de pago", "default": "Pago único" },
    { "type": "textarea", "id": "lead", "label": "Texto de apoyo", "default": "Nos cuentas cómo es tu negocio y te entregamos la web lista para que la vean tus clientes." },
    { "type": "header", "content": "Botones" },
    { "type": "text", "id": "cta_label", "label": "Botón principal", "default": "Quiero mi web por 49 €" },
    { "type": "url", "id": "cta_url", "label": "Enlace del botón principal (alternativo)", "info": "Se usa sólo si el ID de variante de abajo está vacío. Vacío = formulario de la página." },
    { "type": "text", "id": "starter_variant_id", "label": "ID de variante del plan STARTER", "info": "Si lo rellenas, el botón compra directamente en el checkout de Shopify." },
    { "type": "text", "id": "cta2_label", "label": "Enlace secundario", "default": "Comparar con los demás planes" },
    { "type": "url", "id": "cta2_url", "label": "Enlace secundario" },
    { "type": "header", "content": "Incluye" },
    { "type": "text", "id": "list_title", "label": "Título de la lista", "default": "Qué incluye" },
    { "type": "textarea", "id": "note", "label": "Nota de transparencia", "default": "Dominio, hosting y servicios adicionales no incluidos. Te decimos el coste exacto antes de empezar." },
    { "type": "header", "content": "Maqueta de ejemplo" },
    { "type": "paragraph", "content": "Se muestra junto a la lista de qué incluye. Si subes una foto de una web real, se usa esa; si no, se genera una maqueta de ejemplo." },
    {
      "type": "select",
      "id": "mockup_kind",
      "label": "Tipo de negocio de ejemplo",
      "options": [
        { "value": "peluqueria", "label": "Peluquería" },
        { "value": "estetica", "label": "Centro de estética" },
        { "value": "unas", "label": "Uñas" },
        { "value": "fisio", "label": "Fisioterapia" },
        { "value": "taller", "label": "Taller mecánico" },
        { "value": "restaurante", "label": "Restaurante" },
        { "value": "electricista", "label": "Electricista" },
        { "value": "inmobiliaria", "label": "Inmobiliaria" }
      ],
      "default": "peluqueria"
    },
    { "type": "image_picker", "id": "mockup_image", "label": "Foto de una web real (opcional)", "info": "Sustituye la maqueta de ejemplo por esta imagen." },
    { "type": "text", "id": "chip1_text", "label": "Chip flotante 1", "default": "Entrega en 7 días" },
    { "type": "text", "id": "chip2_text", "label": "Chip flotante 2", "default": "4,9 de valoración" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Elemento incluido",
      "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "1 página profesional" }]
    }
  ],
  "presets": [
    {
      "name": "Webs · Oferta 49 €",
      "blocks": [
        { "type": "item", "settings": { "text": "1 página profesional" } },
        { "type": "item", "settings": { "text": "Diseño responsive" } },
        { "type": "item", "settings": { "text": "Información del negocio" } },
        { "type": "item", "settings": { "text": "Servicios" } },
        { "type": "item", "settings": { "text": "Fotos" } },
        { "type": "item", "settings": { "text": "WhatsApp" } },
        { "type": "item", "settings": { "text": "Ubicación" } },
        { "type": "item", "settings": { "text": "Formulario de contacto" } },
        { "type": "item", "settings": { "text": "Diseño adaptado a móvil" } }
      ]
    }
  ]
}
{% endschema %}
